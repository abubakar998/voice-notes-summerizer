# Copy this file to .env and fill in the keys. .env is gitignored — never commit it.

# Transcription. Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Summarization. Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides for the defaults in src/config.py
# ASR_PROVIDER=groq                       # "groq" | "local"
# GROQ_ASR_MODEL=whisper-large-v3         # -turbo is faster but fails on Bangla
# LOCAL_ASR_MODEL=small                   # faster-whisper size, needs requirements-dev.txt
# LLM_PROVIDER=gemini                     # "gemini" | "groq"
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# Only needed by eval/run_eval.py --fetch, to pull Common Voice Bangla clips.
# HF_TOKEN=
